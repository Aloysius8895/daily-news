OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
TARGET_TIMEZONE=Asia/Kuala_Lumpur

ENABLE_AI_SUMMARY=true
MAX_FEED_ITEMS_PER_SOURCE=30
MAX_ITEMS_FOR_MODEL=40
MAX_FINAL_ITEMS=12
SIMILARITY_THRESHOLD=0.88
TECH_FOCUS_RATIO=0.67

ENABLE_NOTION=false
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_TITLE_PROPERTY=Name
NOTION_DATE_PROPERTY=Date

ENABLE_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

ENABLE_EMAIL=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_SENDER=
EMAIL_RECIPIENT=

# Optional JSON override examples:
# NEWS_CATEGORIES=["国际","科技","商业","金融","政策","其他"]
# NEWS_FEEDS=[{"name":"Reuters World","url":"https://feeds.reuters.com/Reuters/worldNews","category":"国际"}]
